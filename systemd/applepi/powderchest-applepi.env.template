# /etc/powderchest/powderchest-applepi.env
# Copy this file to /etc/powderchest/powderchest-applepi.env on ApplePi
# sudo mkdir -p /etc/powderchest
# sudo chmod 600 /etc/powderchest/powderchest-applepi.env
# sudo chown admin:admin /etc/powderchest/powderchest-applepi.env

# wg-easy (running locally on ApplePi at port 51821)
# This is the plaintext password you log into the wg-easy web UI with.
WG_EASY_BASE_URL=http://localhost:51821
WG_EASY_PASSWORD=ENTER_PASSWORD_HERE

# How many seconds since last handshake before a peer is considered offline (default 180)
WG_EASY_STALE_SECONDS=180
